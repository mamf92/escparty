rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for multiplayer game rooms
    match /rooms/{roomCode} {
      // Allow fetching a single room by its (4-letter) code — needed for
      // joining games and real-time updates, and this app has no auth to
      // gate it on. Explicitly split from `list`: the app never queries the
      // rooms collection (every read is getDoc/onSnapshot on a known doc
      // path), so there's no legitimate reason to allow enumerating it —
      // `allow read: if true` used to cover both and let anyone list every
      // room in the collection with no code at all.
      allow get: if true;
      allow list: if false;

      // Allow room creation with proper validation
      allow create: if isValidRoomCreation();

      // Allow updates for specific operations with validation
      allow update: if isValidRoomUpdate();

      // Prevent deletion of rooms
      allow delete: if false;
    }

    // Helper functions for validation
    function isValidRoomCreation() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'hostId', 'started', 'createdAt', 'players']) &&
             data.id is string &&
             data.hostId is string &&
             data.started == false &&
             data.players is list &&
             data.players.size() == 1 &&
             isValidPlayer(data.players[0]) &&
             data.players[0].id == data.hostId &&
             // Optional fields validation
             (!('difficulty' in data) || data.difficulty is string) &&
             (!('hostIsObserver' in data) || data.hostIsObserver is bool) &&
             (!('continueReady' in data) || data.continueReady is bool) &&
             (!('playersAtMidQuiz' in data) || data.playersAtMidQuiz is list) &&
             // Shared progression state (#61). Optional so clients that predate
             // it can still create rooms; when present, a new room must start in
             // the lobby on question 0, stamped with the server's clock.
             (!('phase' in data) || data.phase == 'lobby') &&
             (!('currentQuestionIndex' in data) || data.currentQuestionIndex == 0) &&
             (!('phaseStartedAt' in data) || data.phaseStartedAt == request.time);
    }

    function isValidRoomUpdate() {
      // Computed once and threaded through, rather than each branch below
      // calling request.resource.data.diff(resource.data) independently —
      // diff() is expensive enough that doing it up to six times per write
      // (once per OR branch tried) was blowing the rules engine's per-request
      // expression budget on some writes.
      let affected = request.resource.data.diff(resource.data).affectedKeys();

      return (
        // Setting difficulty
        isSettingDifficulty(affected) ||
        // Adding a player to the room
        isAddingPlayer(affected) ||
        // Starting the game
        isStartingGame(affected) ||
        // Updating player scores
        isUpdatingPlayerScores(affected) ||
        // Setting continue ready state
        isSettingContinueReady(affected) ||
        // Managing mid-quiz players
        isManagingMidQuizPlayers(affected) ||
        // Moving between question / mid-quiz break / results
        isAdvancingPhase(affected)
      );
    }

    function isSettingDifficulty(affected) {
      let data = request.resource.data;
      let existingData = resource.data;

      // Once set, difficulty is a one-shot choice — not re-settable, even
      // before the game starts. Without auth there's no way to check the
      // caller is actually the host, so this is the closest enforceable
      // proxy for "only the host sets difficulty, and only once."
      // `difficulty` names the quiz (src/utils/quizCatalog.ts): a classic
      // difficulty, or a premade quiz as `t-` plus its template id (#72).
      return affected.hasOnly(['difficulty']) &&
             !('difficulty' in existingData) &&
             'difficulty' in data &&
             data.difficulty is string &&
             (data.difficulty in ['easy', 'medium', 'hard'] ||
              data.difficulty.matches('t-[a-z0-9-]{1,40}')) &&
             existingData.started == false;
    }

    function isAddingPlayer(affected) {
      let data = request.resource.data;
      let existingData = resource.data;

      // Only the players field may change, and it must grow by exactly one
      // (matching addPlayerToRoom's arrayUnion of a single new player). Every
      // entry in the resulting array is shape-validated via allPlayersValid,
      // not just the appended one — a plain updateDoc({players: [...]}) can
      // rewrite any index, not only append, so "the array grew by one"
      // doesn't by itself guarantee the earlier entries are untouched. This
      // doesn't check the new player's id against the caller's identity,
      // since this app has no auth to check it against (see
      // docs/agent/firestore-data-model.md) — same limitation as
      // isUpdatingPlayerScores below.
      //
      // Type-checks are ordered deliberately: `is list` must short-circuit
      // before any `.size()`/index access below it, since those throw
      // (denying the whole isValidRoomUpdate() OR-chain via an evaluation
      // error, rather than this branch cleanly evaluating to false) when
      // called on a non-list.
      return affected.hasOnly(['players']) &&
             existingData.started == false &&
             data.players is list &&
             existingData.players is list &&
             data.players.size() == existingData.players.size() + 1 &&
             allPlayersValid(data.players);
    }

    function isStartingGame(affected) {
      let data = request.resource.data;
      let existingData = resource.data;

      // Starting moves the room into its first question in the same write.
      // phaseStartedAt must be the server's request time, so no client can
      // back-date the clock that questions are paced against. (The legacy
      // started-only write from before #61 is no longer accepted: a game
      // started that way would have no phase for clients to follow.)
      return affected.hasOnly(['started', 'phase', 'currentQuestionIndex', 'phaseStartedAt']) &&
             data.started == true &&
             existingData.started == false &&
             'difficulty' in existingData &&
             data.phase == 'question' &&
             data.currentQuestionIndex == 0 &&
             data.phaseStartedAt == request.time;
    }

    // Moving a started room from one phase to the next (#62). Mirrors
    // phaseAfterQuestion in src/utils/quizTiming.ts:
    //   question N -> question N+1          (N+1 not a multiple of 5)
    //   question N -> mid-scoreboard at N+1 (N+1 a multiple of 5)
    //   question N -> results               (index unchanged)
    //   mid-scoreboard N -> question N      (host resumes after the break,
    //                                        clearing playersAtMidQuiz)
    // A question can't be ended before its 15s slot (QUESTION_SLOT_MS) is
    // over, so no client can cut one short or race ahead; phaseStartedAt is
    // always the server's request time. Rules can't see how many questions
    // a quiz has, so "results" is allowed from any question.
    function isAdvancingPhase(affected) {
      let data = request.resource.data;
      let existingData = resource.data;

      return affected.hasOnly(['phase', 'currentQuestionIndex', 'phaseStartedAt', 'playersAtMidQuiz']) &&
             // A phase move may only touch the ready marks to clear them, and
             // only when resuming. This is the only way to clear them in a
             // room with a phase: isManagingMidQuizPlayers only lets a write
             // append one mark, during the break.
             (!affected.hasAny(['playersAtMidQuiz']) ||
              (existingData.phase == 'mid-scoreboard' &&
               data.playersAtMidQuiz is list &&
               data.playersAtMidQuiz.size() == 0)) &&
             existingData.started == true &&
             'phase' in existingData &&
             'currentQuestionIndex' in existingData &&
             'phaseStartedAt' in existingData &&
             data.phaseStartedAt == request.time &&
             data.currentQuestionIndex is int &&
             (
               (existingData.phase == 'question' &&
                request.time >= existingData.phaseStartedAt + duration.value(15, 's') &&
                (
                  (data.phase == 'question' &&
                   data.currentQuestionIndex == existingData.currentQuestionIndex + 1 &&
                   data.currentQuestionIndex % 5 != 0) ||
                  (data.phase == 'mid-scoreboard' &&
                   data.currentQuestionIndex == existingData.currentQuestionIndex + 1 &&
                   data.currentQuestionIndex % 5 == 0) ||
                  (data.phase == 'results' &&
                   data.currentQuestionIndex == existingData.currentQuestionIndex)
                )) ||
               (existingData.phase == 'mid-scoreboard' &&
                data.phase == 'question' &&
                data.currentQuestionIndex == existingData.currentQuestionIndex)
             );
    }

    function isUpdatingPlayerScores(affected) {
      let data = request.resource.data;
      let existingData = resource.data;

      return affected.hasOnly(['players']) &&
             existingData.started == true &&
             data.players is list &&
             existingData.players is list &&
             data.players.size() == existingData.players.size() &&
             allPlayersValid(data.players);
    }

    function isSettingContinueReady(affected) {
      let data = request.resource.data;

      return affected.hasOnly(['continueReady']) &&
             'continueReady' in data &&
             data.continueReady is bool;
    }

    // A player marking itself ready at the mid-quiz break
    // (markPlayerAtMidQuiz). In a room with a phase (#61), marks only count
    // while the room is in the break, and a write must keep every existing
    // mark and add exactly one new player ID (a string) as the last entry,
    // which is what arrayUnion does. (The order of the existing marks isn't
    // checked.) Clearing them is the resume's job (isAdvancingPhase), and
    // one client can't mark everyone ready in a single write. Without
    // sign-in the rules can't tell whose ID a mark is, so a client could
    // still mark others one write at a time; per-player state on the room
    // is #64. Otherwise a mark that was queued offline or on a slow network
    // lands after the resume and counts the player as ready at the next
    // break before they get there (#63).
    // Rooms without a phase keep the old anything-goes list. (A mark sent
    // again, e.g. after a refresh, changes nothing, so no field is affected
    // and isUpdatingPlayerScores already lets it through.)
    function isManagingMidQuizPlayers(affected) {
      let data = request.resource.data;
      let marks = data.playersAtMidQuiz;
      let before = resource.data.get('playersAtMidQuiz', []);

      return affected.hasOnly(['playersAtMidQuiz']) &&
             'playersAtMidQuiz' in data &&
             marks is list &&
             (!('phase' in resource.data) ||
              (resource.data.phase == 'mid-scoreboard' &&
               marks.size() == before.size() + 1 &&
               marks.hasAll(before) &&
               marks[marks.size() - 1] is string &&
               !before.hasAny([marks[marks.size() - 1]])));
    }

    function isValidPlayer(player) {
      return player is map &&
             player.keys().hasAll(['id', 'name', 'score']) &&
             player.id is string &&
             player.name is string &&
             player.score is number &&
             player.score >= 0 &&
             // Optional joinedAt field
             (!('joinedAt' in player) || player.joinedAt is timestamp);
    }

    // Simplified player validation for bulk operations
    function isValidPlayerBasic(player) {
      return player is map &&
             'id' in player &&
             'name' in player &&
             'score' in player &&
             player.id is string &&
             player.name is string &&
             player.score is number &&
             player.score >= 0;
    }

    // Firestore Rules has no loop/`.every()` construct and no recursion, so
    // "validate every element of a list" has to be unrolled by hand up to a
    // fixed bound. 32 comfortably covers a realistic party-quiz room; a room
    // that somehow exceeds it is rejected outright by the size check below
    // rather than silently validated. isValidPlayerAt(i) is trivially true
    // once i is past the end of the list, so this works for any list from
    // size 0 up to the bound.
    function isValidPlayerAt(players, i) {
      return i >= players.size() || isValidPlayerBasic(players[i]);
    }

    function allPlayersValid(players) {
      return players.size() <= 32 &&
        isValidPlayerAt(players, 0) && isValidPlayerAt(players, 1) &&
        isValidPlayerAt(players, 2) && isValidPlayerAt(players, 3) &&
        isValidPlayerAt(players, 4) && isValidPlayerAt(players, 5) &&
        isValidPlayerAt(players, 6) && isValidPlayerAt(players, 7) &&
        isValidPlayerAt(players, 8) && isValidPlayerAt(players, 9) &&
        isValidPlayerAt(players, 10) && isValidPlayerAt(players, 11) &&
        isValidPlayerAt(players, 12) && isValidPlayerAt(players, 13) &&
        isValidPlayerAt(players, 14) && isValidPlayerAt(players, 15) &&
        isValidPlayerAt(players, 16) && isValidPlayerAt(players, 17) &&
        isValidPlayerAt(players, 18) && isValidPlayerAt(players, 19) &&
        isValidPlayerAt(players, 20) && isValidPlayerAt(players, 21) &&
        isValidPlayerAt(players, 22) && isValidPlayerAt(players, 23) &&
        isValidPlayerAt(players, 24) && isValidPlayerAt(players, 25) &&
        isValidPlayerAt(players, 26) && isValidPlayerAt(players, 27) &&
        isValidPlayerAt(players, 28) && isValidPlayerAt(players, 29) &&
        isValidPlayerAt(players, 30) && isValidPlayerAt(players, 31);
    }

    // Default deny all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
