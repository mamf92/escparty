rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for multiplayer game rooms
    match /rooms/{roomCode} {
      // Allow fetching a single room by its (4-letter) code — needed for
      // joining games and real-time updates, and this app has no auth to
      // gate it on. Explicitly split from `list`: the app never queries the
      // rooms collection (every read is getDoc/onSnapshot on a known doc
      // path), so there's no legitimate reason to allow enumerating it —
      // `allow read: if true` used to cover both and let anyone list every
      // room in the collection with no code at all.
      allow get: if true;
      allow list: if false;

      // Allow room creation with proper validation
      allow create: if isValidRoomCreation();

      // Allow updates for specific operations with validation
      allow update: if isValidRoomUpdate();

      // Prevent deletion of rooms
      allow delete: if false;
    }

    // Helper functions for validation
    function isValidRoomCreation() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'hostId', 'started', 'createdAt', 'players']) &&
             data.id is string &&
             data.hostId is string &&
             data.started == false &&
             data.players is list &&
             data.players.size() == 1 &&
             isValidPlayer(data.players[0]) &&
             data.players[0].id == data.hostId &&
             // Optional fields validation
             (!('difficulty' in data) || isQuizKey(data.difficulty)) &&
             (!('breakEvery' in data) || isBreakEvery(data.breakEvery)) &&
             (!('hostIsObserver' in data) || data.hostIsObserver is bool) &&
             !('nextRoomCode' in data) &&
             !('readyPlayers' in data) &&
             !('revealStep' in data) &&
             (!('continueReady' in data) || data.continueReady is bool) &&
             (!('playersAtMidQuiz' in data) || data.playersAtMidQuiz is list) &&
             // Shared progression state (#61). Optional so clients that predate
             // it can still create rooms; when present, a new room must start in
             // the lobby on question 0, stamped with the server's clock.
             (!('phase' in data) || data.phase == 'lobby') &&
             (!('currentQuestionIndex' in data) || data.currentQuestionIndex == 0) &&
             (!('phaseStartedAt' in data) || data.phaseStartedAt == request.time);
    }

    function isValidRoomUpdate() {
      // Computed once and threaded through, rather than each branch below
      // calling request.resource.data.diff(resource.data) independently —
      // diff() is expensive enough that doing it up to six times per write
      // (once per OR branch tried) was blowing the rules engine's per-request
      // expression budget on some writes.
      let affected = request.resource.data.diff(resource.data).affectedKeys();

      return (
        // Setting difficulty
        isSettingDifficulty(affected) ||
        // Adding a player to the room
        isAddingPlayer(affected) ||
        // Starting the game
        isStartingGame(affected) ||
        // Updating player scores
        isUpdatingPlayerScores(affected) ||
        // Setting continue ready state
        isSettingContinueReady(affected) ||
        // Managing mid-quiz players
        isManagingMidQuizPlayers(affected) ||
        // Moving between question / mid-quiz break / results
        isAdvancingPhase(affected) ||
        // Pointing a finished room at the next round (#21)
        isSettingNextRoom(affected) ||
        // The host revealing the final standings, a step at a time (#207)
        isRevealing(affected) ||
        // A player saying they're ready in the lobby (#65)
        isSettingReady(affected) ||
        // The host removing a player from the lobby (#65)
        isRemovingPlayer(affected)
      );
    }

    function isSettingDifficulty(affected) {
      let data = request.resource.data;
      let existingData = resource.data;

      // Once set, difficulty is a one-shot choice — not re-settable, even
      // before the game starts. Without auth there's no way to check the
      // caller is actually the host, so this is the closest enforceable
      // proxy for "only the host sets difficulty, and only once."
      // `difficulty` names the quiz: see isQuizKey.
      // The quiz's break setting (breakEvery) may ride along, once.
      return affected.hasOnly(['difficulty', 'breakEvery']) &&
             !('difficulty' in existingData) &&
             !('breakEvery' in existingData) &&
             'difficulty' in data &&
             isQuizKey(data.difficulty) &&
             (!('breakEvery' in data) || isBreakEvery(data.breakEvery)) &&
             existingData.started == false;
    }

    // What a room's `difficulty` may name (src/utils/quizCatalog.ts): a
    // classic difficulty, a premade quiz as `t-` plus its template id (#72),
    // or a saved custom quiz as `c-` plus its quizzes/ document id (#77).
    function isQuizKey(value) {
      return value is string &&
             (value in ['easy', 'medium', 'hard'] ||
              value.matches('t-[a-z0-9-]{1,40}') ||
              value.matches('c-[A-Za-z0-9]{20}'));
    }

    // How often a room's mid-quiz break comes: after every Nth question, or
    // never (0). BREAK_CHOICES in src/utils/quizModel.ts.
    function isBreakEvery(value) {
      return value in [0, 3, 4, 5, 10];
    }

    function isAddingPlayer(affected) {
      let data = request.resource.data;
      let existingData = resource.data;

      // Only the players field may change, and it must grow by exactly one
      // (matching addPlayerToRoom's arrayUnion of a single new player). Every
      // entry in the resulting array is shape-validated via allPlayersValid,
      // not just the appended one — a plain updateDoc({players: [...]}) can
      // rewrite any index, not only append, so "the array grew by one"
      // doesn't by itself guarantee the earlier entries are untouched. This
      // doesn't check the new player's id against the caller's identity,
      // since this app has no auth to check it against (see
      // docs/agent/firestore-data-model.md) — same limitation as
      // isUpdatingPlayerScores below.
      //
      // Type-checks are ordered deliberately: `is list` must short-circuit
      // before any `.size()`/index access below it, since those throw
      // (denying the whole isValidRoomUpdate() OR-chain via an evaluation
      // error, rather than this branch cleanly evaluating to false) when
      // called on a non-list.
      return affected.hasOnly(['players']) &&
             existingData.started == false &&
             data.players is list &&
             existingData.players is list &&
             data.players.size() == existingData.players.size() + 1 &&
             allPlayersValid(data.players);
    }

    function isStartingGame(affected) {
      let data = request.resource.data;
      let existingData = resource.data;

      // Starting moves the room into its first question in the same write.
      // phaseStartedAt must be the server's request time, so no client can
      // back-date the clock that questions are paced against. (The legacy
      // started-only write from before #61 is no longer accepted: a game
      // started that way would have no phase for clients to follow.)
      return affected.hasOnly(['started', 'phase', 'currentQuestionIndex', 'phaseStartedAt']) &&
             data.started == true &&
             existingData.started == false &&
             'difficulty' in existingData &&
             data.phase == 'question' &&
             data.currentQuestionIndex == 0 &&
             data.phaseStartedAt == request.time;
    }

    // Moving a started room from one phase to the next (#62). Mirrors
    // phaseAfterQuestion in src/utils/quizTiming.ts:
    //   question N -> question N+1          (no break before N+1)
    //   question N -> mid-scoreboard at N+1 (a break before N+1: N+1 a
    //                                        multiple of the room's
    //                                        breakEvery, 5 if unset, never
    //                                        if 0; see isBreakBefore)
    //   question N -> results               (index unchanged)
    //   mid-scoreboard N -> question N      (host resumes after the break,
    //                                        clearing playersAtMidQuiz)
    // A question can't be ended before its 15s slot (QUESTION_SLOT_MS) is
    // over, so no client can cut one short or race ahead; phaseStartedAt is
    // always the server's request time. Rules can't see how many questions
    // a quiz has, so "results" is allowed from any question.
    function isAdvancingPhase(affected) {
      let data = request.resource.data;
      let existingData = resource.data;

      return affected.hasOnly(['phase', 'currentQuestionIndex', 'phaseStartedAt', 'playersAtMidQuiz']) &&
             // A phase move may only touch the ready marks to clear them, and
             // only when resuming. This is the only way to clear them in a
             // room with a phase: isManagingMidQuizPlayers only lets a write
             // append one mark, during the break.
             (!affected.hasAny(['playersAtMidQuiz']) ||
              (existingData.phase == 'mid-scoreboard' &&
               data.playersAtMidQuiz is list &&
               data.playersAtMidQuiz.size() == 0)) &&
             existingData.started == true &&
             'phase' in existingData &&
             'currentQuestionIndex' in existingData &&
             'phaseStartedAt' in existingData &&
             data.phaseStartedAt == request.time &&
             data.currentQuestionIndex is int &&
             (
               (existingData.phase == 'question' &&
                request.time >= existingData.phaseStartedAt + duration.value(15, 's') &&
                (
                  (data.phase == 'question' &&
                   data.currentQuestionIndex == existingData.currentQuestionIndex + 1 &&
                   !isBreakBefore(data.currentQuestionIndex, existingData.get('breakEvery', 5))) ||
                  (data.phase == 'mid-scoreboard' &&
                   data.currentQuestionIndex == existingData.currentQuestionIndex + 1 &&
                   isBreakBefore(data.currentQuestionIndex, existingData.get('breakEvery', 5))) ||
                  (data.phase == 'results' &&
                   data.currentQuestionIndex == existingData.currentQuestionIndex)
                )) ||
               (existingData.phase == 'mid-scoreboard' &&
                data.phase == 'question' &&
                data.currentQuestionIndex == existingData.currentQuestionIndex)
             );
    }

    // Whether the mid-quiz break comes before question `index`, for a room
    // breaking every `every` questions (0: never; rooms without the field
    // break every 5). Same arithmetic as phaseAfterQuestion in quizTiming.ts.
    function isBreakBefore(index, every) {
      return every > 0 && index % every == 0;
    }

    function isUpdatingPlayerScores(affected) {
      let data = request.resource.data;
      let existingData = resource.data;

      return affected.hasOnly(['players']) &&
             existingData.started == true &&
             isNotFinished(existingData) &&
             data.players is list &&
             existingData.players is list &&
             data.players.size() == existingData.players.size() &&
             allPlayersValid(data.players);
    }

    // The host starting another round with the same guests (setNextRoom,
    // #21): a finished room gets the new room's code, once. Like every room
    // write, this checks shape, not who (no auth, #115).
    function isSettingNextRoom(affected) {
      return affected.hasOnly(['nextRoomCode']) &&
             resource.data.get('phase', '') == 'results' &&
             !('nextRoomCode' in resource.data) &&
             request.resource.data.nextRoomCode is string &&
             request.resource.data.nextRoomCode.matches('[A-Z]{4}') &&
             request.resource.data.nextRoomCode != resource.data.id &&
             // Only a real room, just made by the same host and still in
             // its lobby, so a stranger can't point the guests elsewhere.
             exists(/databases/$(database)/documents/rooms/$(request.resource.data.nextRoomCode)) &&
             get(/databases/$(database)/documents/rooms/$(request.resource.data.nextRoomCode)).data.hostId == resource.data.hostId &&
             get(/databases/$(database)/documents/rooms/$(request.resource.data.nextRoomCode)).data.get('phase', 'lobby') == 'lobby';
    }

    // setRevealStep (#207): the host's reveal taps on the results, which
    // every phone follows. Forward only (a step may repeat, never drop) and
    // capped, so the number can't be abused; it's a count of taps, and a
    // quiz's reveal is a handful. Like every room write this checks shape,
    // not who: with no auth (#115) the rules can't tell the host from a
    // guest, so "only the host" is the page's job and not enforced here.
    function isRevealing(affected) {
      return affected.hasOnly(['revealStep']) &&
             resource.data.get('phase', '') == 'results' &&
             'revealStep' in request.resource.data &&
             request.resource.data.revealStep is int &&
             request.resource.data.revealStep >= resource.data.get('revealStep', 0) &&
             request.resource.data.revealStep <= 100;
    }

    // setPlayerReady: one id added (arrayUnion) or removed (arrayRemove)
    // from readyPlayers, before the game starts. The id isn't checked
    // against the players (the rules can't search a list of maps), so a
    // stray id only ever counts for nobody.
    function isSettingReady(affected) {
      let before = resource.data.get('readyPlayers', []);
      let after = request.resource.data.readyPlayers;
      return affected.hasOnly(['readyPlayers']) &&
             resource.data.started == false &&
             after is list &&
             after.size() <= 32 &&
             ((after.size() == before.size() + 1 && after.hasAll(before) &&
               after[after.size() - 1] is string && after[after.size() - 1].size() <= 64) ||
              (after.size() == before.size() - 1 && before.hasAll(after)) ||
              after == before);
    }

    // removePlayerFromRoom: exactly one entry leaves the lobby (never the
    // host, who stays first), and at most one ready mark goes with it. Like
    // every room write there's no sign-in to check who asks (see
    // docs/agent/firestore-data-model.md), so anyone with the code could
    // remove a guest, who can join again with the code.
    function isRemovingPlayer(affected) {
      let data = request.resource.data;
      let existingData = resource.data;
      return affected.hasOnly(['players', 'readyPlayers']) &&
             existingData.started == false &&
             data.players is list &&
             data.players.size() == existingData.players.size() - 1 &&
             data.players.size() >= 1 &&
             existingData.players.hasAll(data.players) &&
             data.players[0].id == existingData.hostId &&
             data.get('readyPlayers', []) is list &&
             existingData.get('readyPlayers', []).hasAll(data.get('readyPlayers', [])) &&
             data.get('readyPlayers', []).size() >= existingData.get('readyPlayers', []).size() - 1;
    }

    function isSettingContinueReady(affected) {
      let data = request.resource.data;

      return affected.hasOnly(['continueReady']) &&
             'continueReady' in data &&
             data.continueReady is bool &&
             // Unused since #63: rooms with a phase never need it.
             !('phase' in resource.data);
    }

    // A finished room (phase 'results') takes no more score writes (#142),
    // so its final scores can't be rewritten afterwards, except in the first
    // 30s (RESULTS_GRACE_MS in src/utils/quizTiming.ts): the last answer's
    // write (or its retry) can land just after the room moves on. During
    // those 30s a client can rewrite scores exactly as it could during the
    // quiz (rules check shape, not whose score it is). isAdvancingPhase has
    // no move out of 'results', isManagingMidQuizPlayers only allows marks
    // in a break, and continueReady is refused in any room with a phase.
    function isNotFinished(room) {
      return room.get('phase', '') != 'results' ||
             request.time < room.phaseStartedAt + duration.value(30, 's');
    }

    // A player marking itself ready at the mid-quiz break
    // (markPlayerAtMidQuiz). In a room with a phase (#61), marks only count
    // while the room is in the break, and a write must keep every existing
    // mark and add exactly one new player ID (a string) as the last entry,
    // which is what arrayUnion does. (The order of the existing marks isn't
    // checked.) Clearing them is the resume's job (isAdvancingPhase), and
    // one client can't mark everyone ready in a single write. Without
    // sign-in the rules can't tell whose ID a mark is, so a client could
    // still mark others one write at a time; per-player state on the room
    // is #64. Otherwise a mark that was queued offline or on a slow network
    // lands after the resume and counts the player as ready at the next
    // break before they get there (#63).
    // Rooms without a phase keep the old anything-goes list. (A mark sent
    // again, e.g. after a refresh, changes nothing, so no field is affected
    // and isUpdatingPlayerScores already lets it through.)
    function isManagingMidQuizPlayers(affected) {
      let data = request.resource.data;
      let marks = data.playersAtMidQuiz;
      let before = resource.data.get('playersAtMidQuiz', []);

      return affected.hasOnly(['playersAtMidQuiz']) &&
             'playersAtMidQuiz' in data &&
             marks is list &&
             (!('phase' in resource.data) ||
              (resource.data.phase == 'mid-scoreboard' &&
               marks.size() == before.size() + 1 &&
               marks.hasAll(before) &&
               marks[marks.size() - 1] is string &&
               !before.hasAny([marks[marks.size() - 1]])));
    }

    function isValidPlayer(player) {
      return player is map &&
             player.keys().hasAll(['id', 'name', 'score']) &&
             player.id is string &&
             player.name is string &&
             player.score is number &&
             player.score >= 0 &&
             // Optional joinedAt field
             (!('joinedAt' in player) || player.joinedAt is timestamp);
    }

    // Simplified player validation for bulk operations
    function isValidPlayerBasic(player) {
      return player is map &&
             'id' in player &&
             'name' in player &&
             'score' in player &&
             player.id is string &&
             player.name is string &&
             player.score is number &&
             player.score >= 0;
    }

    // Firestore Rules has no loop/`.every()` construct and no recursion, so
    // "validate every element of a list" has to be unrolled by hand up to a
    // fixed bound. 32 comfortably covers a realistic party-quiz room; a room
    // that somehow exceeds it is rejected outright by the size check below
    // rather than silently validated. isValidPlayerAt(i) is trivially true
    // once i is past the end of the list, so this works for any list from
    // size 0 up to the bound.
    function isValidPlayerAt(players, i) {
      return i >= players.size() || isValidPlayerBasic(players[i]);
    }

    function allPlayersValid(players) {
      return players.size() <= 32 &&
        isValidPlayerAt(players, 0) && isValidPlayerAt(players, 1) &&
        isValidPlayerAt(players, 2) && isValidPlayerAt(players, 3) &&
        isValidPlayerAt(players, 4) && isValidPlayerAt(players, 5) &&
        isValidPlayerAt(players, 6) && isValidPlayerAt(players, 7) &&
        isValidPlayerAt(players, 8) && isValidPlayerAt(players, 9) &&
        isValidPlayerAt(players, 10) && isValidPlayerAt(players, 11) &&
        isValidPlayerAt(players, 12) && isValidPlayerAt(players, 13) &&
        isValidPlayerAt(players, 14) && isValidPlayerAt(players, 15) &&
        isValidPlayerAt(players, 16) && isValidPlayerAt(players, 17) &&
        isValidPlayerAt(players, 18) && isValidPlayerAt(players, 19) &&
        isValidPlayerAt(players, 20) && isValidPlayerAt(players, 21) &&
        isValidPlayerAt(players, 22) && isValidPlayerAt(players, 23) &&
        isValidPlayerAt(players, 24) && isValidPlayerAt(players, 25) &&
        isValidPlayerAt(players, 26) && isValidPlayerAt(players, 27) &&
        isValidPlayerAt(players, 28) && isValidPlayerAt(players, 29) &&
        isValidPlayerAt(players, 30) && isValidPlayerAt(players, 31);
    }

    // Saved custom quizzes (#76). There is no sign-in, so a quiz's random
    // document id is what lets someone read it: the app only ever gets one
    // by id (to play or host it), never lists the collection. A saved quiz
    // never changes, so every player in a room plays the same questions;
    // editing saves a new one. Each question's shape is checked by the
    // client (quizModel.questionProblems) when it loads the quiz, since
    // rules can't loop over a 50-entry list.
    match /quizzes/{quizId} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidQuiz();
      allow update, delete: if false;
    }

    function isValidQuiz() {
      let data = request.resource.data;
      return data.keys().hasOnly(['title', 'breakEvery', 'questions', 'createdAt']) &&
             data.keys().hasAll(['title', 'breakEvery', 'questions', 'createdAt']) &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 60 &&
             isBreakEvery(data.breakEvery) &&
             data.questions is list &&
             data.questions.size() > 0 &&
             data.questions.size() <= 50 &&
             data.createdAt == request.time;
    }

    // Scoreboard parties (#79). A party is found by its 4-letter code, never
    // listed. Without sign-in the rules can't tell the host from a guest,
    // so a host-only edit (running order, results, opening the awards) is
    // limited by shape, the same trust model as quiz rooms: anyone with the
    // code could make one. Each guest's ratings are their own document
    // under ballots/, so guests never write over each other.
    match /parties/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidPartyCreation(code);
      allow update: if isValidPartyUpdate();
      allow delete: if false;

      // Ballots are read together (the room's standings, the awards), so
      // listing them within a party is allowed.
      match /ballots/{guestId} {
        allow read: if true;
        allow create, update: if isValidBallot(code);
        allow delete: if false;
      }
    }

    // A show's real running order, written by the project owner in the
    // Firebase console once it's announced (docs/agent/scoreboard-party.md).
    // Clients only read it; without it they use the bundled fictive one.
    match /contests/{contestId} {
      allow get: if true;
      allow list, write: if false;
    }

    function isValidPartyCreation(code) {
      let data = request.resource.data;
      return code.matches('[A-Z]{4}') &&
             data.keys().hasOnly(['code', 'hostId', 'title', 'contestId', 'kind', 'qualifiers', 'acts',
                                  'template', 'bonuses', 'showNames', 'results', 'revealed', 'createdAt', 'expireAt']) &&
             data.keys().hasAll(['code', 'hostId', 'title', 'contestId', 'kind', 'qualifiers', 'acts',
                                 'template', 'bonuses', 'showNames', 'results', 'revealed', 'createdAt', 'expireAt']) &&
             data.code == code &&
             data.hostId is string && data.hostId.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 80 &&
             data.contestId is string && data.contestId.size() <= 60 &&
             data.kind in ['semi', 'final'] &&
             data.qualifiers is int && data.qualifiers >= 0 && data.qualifiers <= 40 &&
             isValidActs(data.acts) &&
             data.template is map &&
             data.template.categories is list &&
             data.template.categories.size() > 0 &&
             data.template.categories.size() <= 6 &&
             data.bonuses is bool &&
             data.showNames is bool &&
             data.results == {} &&
             data.revealed == false &&
             data.createdAt == request.time &&
             // Kept about 30 days (PARTY_LIFETIME_DAYS), for a TTL policy on expireAt.
             data.expireAt is timestamp &&
             // A wide window: expireAt comes from the phone's own clock.
             data.expireAt > request.time + duration.value(1, 'd') &&
             data.expireAt < request.time + duration.value(60, 'd');
    }

    // The host's edits: the running order, the real results, opening the
    // awards. One of them per write; nothing else about a party changes.
    function isValidPartyUpdate() {
      let data = request.resource.data;
      let affected = data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['acts', 'results', 'revealed']) &&
             isValidActs(data.acts) &&
             data.results is map &&
             data.results.keys().hasOnly(['places', 'qualifiers']) &&
             (!('places' in data.results) || (data.results.places is map && data.results.places.size() <= 40)) &&
             (!('qualifiers' in data.results) || (data.results.qualifiers is list && data.results.qualifiers.size() <= 40)) &&
             data.revealed is bool;
    }

    function isValidActs(acts) {
      return acts is list && acts.size() > 0 && acts.size() <= 40;
    }

    // A guest's ratings. Written whole on every change (saveBallot), always
    // stamped with the server's clock, and only inside a party that exists.
    function isValidBallot(code) {
      let data = request.resource.data;
      return exists(/databases/$(database)/documents/parties/$(code)) &&
             data.keys().hasOnly(['name', 'ratings', 'bonuses', 'updatedAt', 'expireAt']) &&
             data.keys().hasAll(['name', 'ratings', 'bonuses', 'updatedAt', 'expireAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 40 &&
             data.ratings is map && data.ratings.size() <= 40 &&
             data.bonuses is map && data.bonuses.size() <= 40 &&
             data.updatedAt == request.time &&
             // Kept about 30 days after the last change, for a TTL policy on expireAt.
             data.expireAt is timestamp &&
             // A wide window: expireAt comes from the phone's own clock.
             data.expireAt > request.time + duration.value(1, 'd') &&
             data.expireAt < request.time + duration.value(60, 'd');
    }

    // Default deny all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
