{
  "name": "escparty",
  "homepage": "https://escparty-murex.vercel.app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "emulators": "firebase emulators:start --only firestore",
    "preview": "vite preview",
    "test:e2e": "npx -y firebase-tools@15.31.0 emulators:exec --only firestore --project demo-escparty \"playwright test\""
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "firebase": "^12.19.0",
    "jsqr": "^1.4.0",
    "leva": "^0.10.1",
    "qrcode": "^1.5.4",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-router-dom": "^7.18.4",
    "styled-components": "^6.5.3",
    "three": "^0.186.1",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
